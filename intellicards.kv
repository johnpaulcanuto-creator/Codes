<QuizMedScreen>:

    name: "QuizMed"

    MDFloatLayout:
        md_bg_color: 0.102, 0.384, 0.557, 1

        MDTopAppBar:
            id: top_bar
            title: "Quiz Deck"
            pos_hint: {"top": 1}
            md_bg_color: 0.07, 0.28, 0.41, 1 
            elevation: 3
            left_action_items: [["lightbulb-outline", lambda x: app.show_hint()]]

        


        MDLabel:
            id: subject_label
            text: ""
            font_style: "H5"
            halign: "center"
            pos_hint: {"center_x": 0.5, "top": 0.95}
            theme_text_color: "Custom"
            text_color: 1, 1, 0.6, 1
            
        MDLabel:
            id: progress_label
            text: "0/0"
            font_style: "Subtitle1"
            halign: "center"
            pos_hint: {"center_x": 0.5, "top": 0.88}
            theme_text_color: "Custom"
            text_color: 1, 1, 0.6, 1
            
        MDCard:
            size_hint: 0.9, 0.4
            pos_hint: {"center_x": 0.5, "center_y": 0.6}
            elevation: 2
            padding: "20dp"
            orientation: "vertical"
            md_bg_color: 0.914, 0.796, 0.467, 1
            
            MDLabel:
                id: question_label
                text: ""
                font_style: "H6"
                halign: "center"
                valign: "center"
                size_hint_y: None
                height: self.texture_size[1]
                theme_text_color: "Custom"
                text_color: 0.1, 0.1, 0.5, 1

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(5)
                size_hint_y: None
                height: self.minimum_height

            MDRaisedButton:
                text: "🔇 Mute Music"
                pos_hint: {"center_x": 0.5}
                on_release: app.toggle_music()

            Widget:
                size_hint_y: None
                height: dp(5) 

            MDRaisedButton:
                text: "🔊 Read Question"
                pos_hint: {"center_x": 0.5}
                on_release:
                    app.speak_text(root.ids.question_label.text)

                
        GridLayout:
            cols: 1
            rows: 4
            spacing: dp(20)
            padding: dp(40)
            size_hint: 1, 0.4
            pos_hint: {"center_x": 0.6, "center_y": 0.2}

            MDRoundFlatIconButton:
                id: button_a
                text: "A"
                md_bg_color: 1, 1, 0.7, 1
                theme_text_color: "Custom"
                text_color: 0.1, 0.1, 0.5, 1
                on_release: app.check_answer(True)

            MDRoundFlatIconButton:
                id: button_b
                text: "B"
                md_bg_color: 1, 1, 0.7, 1
                theme_text_color: "Custom"
                text_color: 0.1, 0.1, 0.5, 1
                on_release: app.check_answer(False)

            MDRoundFlatIconButton:
                id: button_c
                text: "C"
                md_bg_color: 1, 1, 0.7, 1
                theme_text_color: "Custom"
                text_color: 0.1, 0.1, 0.5, 1
                on_release: app.check_answer(True)

            MDRoundFlatIconButton:
                id: button_d
                text: "D"
                md_bg_color: 1, 1, 0.7, 1
                theme_text_color: "Custom"
                text_color: 0.1, 0.1, 0.5, 1
                on_release: app.check_answer(False)



<QuizHardScreen>:
    name: "QuizHard"

    BoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(10)

        MDLabel:
            id: subject_label
            text: "Subject"
            font_style: "Subtitle1"
            halign: "center"
            theme_text_color: "Secondary"

        MDLabel:
            id: progress_label
            text: "Question x of y"
            font_style: "Subtitle2"
            halign: "center"
            theme_text_color: "Secondary"

        MDLabel:
            id: question_label
            text: "Question text will appear here"
            font_style: "H6"
            halign: "center"
            theme_text_color: "Primary"
            size_hint_y: None
            height: self.texture_size[1] + dp(20)

        MDRaisedButton:
            text: "🔇 Mute Music"
            pos_hint: {"center_x": 0.5}
            on_release: app.toggle_music()

        Widget:
            size_hint_y: None
            height: dp(5) 

        MDRaisedButton:
            text: "🔊 Speak Question"
            pos_hint: {"center_x": 0.5}
            on_release: app.speak_text(root.ids.question_label.text)

        MDTextField:
            id: user_input
            hint_text: "Type your answer"
            mode: "rectangle"
            multiline: False

        MDRaisedButton:
            text: "Submit Answer"
            pos_hint: {"center_x": 0.5}
            on_release:
                app.check_answer(user_input.text)
